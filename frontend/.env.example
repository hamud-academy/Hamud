# =============================================================================
# BaroSmart / E-learning — DHAMMAAN variables-ka app-ku isticmaalo
# =============================================================================
# LOCAL:    copy this file → .env   (Windows: copy .env.example .env)
#            Haddii aad haysato .env.local, wuxuu override gareeyaa .env (Next.js rule).
# VERCEL:   Project → Settings → Environment Variables (same keys & values)
#
# MUUHIIM:  Ha gelin fayl .env (qiimayaasha dhabta ah) GitHub — kaliya .env.example
# =============================================================================

# --- NextAuth v5 (WAA LAGUMA MAARMI KARO production) ---
# Sirta session-ka — samee: openssl rand -base64 32
AUTH_SECRET=

# Public website URL used for uploaded media and email links. Do not use localhost here.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Auth callback URL. Use localhost only for local development; use your public domain in production.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- PostgreSQL + Prisma (WAA LAGUMA MAARMI KARO) ---
# Neon pooled URL (app runtime) — hostname contains "-pooler"
DATABASE_URL=
# Production: DATABASE_URL is required (no fallback). Never run db:seed on production unless ALLOW_SEED=true.
# SEED_ADMIN_PASSWORD=YourStrongAdminPassword1!
# ALLOW_SEED=true
# Neon direct URL (Prisma migrate/deploy) — same credentials, NO "-pooler" in hostname
# Neon dashboard → Connection details → Direct connection
# Optional: prisma.config.ts auto-derives this from DATABASE_URL if omitted
DIRECT_URL=

# --- Vercel Blob (uploads — persistent cloud; NOT temporary local disk) ---
# Waa lagama maarmaan marka DATABASE_URL = Neon. Local dev: isla token → Blob.
# ALLOW_LOCAL_UPLOADS=true kaliya offline dev aan Blob lahayn.
# Vercel → Project → Storage → Blob → Connect; token auto-adds BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- Email sender (MFA security codes, dalabyada, iwm.) ---
# Gmail SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM="BaroSmart <yourgmail@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional fallback: Resend. Not required if SMTP_* values above are configured.
RESEND_API_KEY=
# Cinwaanka "from" (haddii aan la dhigin waa onboarding@resend.dev)
RESEND_FROM=
# Email-ka admin (login recovery + ogeysiisyada dalabyada)
# Mar waliba ADMIN_EMAIL + ADMIN_PASSWORD waxay furi karaan admin section-ka (back-end recovery).
ADMIN_EMAIL=hamud26academy@gmail.com
# Ugu yaraan 8 xaraf, upper, lower, number, symbol (tusaale: Admin@2026!)
ADMIN_PASSWORD=
# Optional: force ADMIN_PASSWORD from env on server restart (haddii aad ilowdo password-ka panel-ka)
# ADMIN_FORCE_PASSWORD_RESET=true

# --- Kaliya gudubinta xogta hal mar (development) — HA KU DARIN Vercel ---
# Neon → Neon: OLD_DATABASE_URL = hore, NEW_DATABASE_URL = cusub. Riix prisma/MIGRATE-DATA.md
# OLD_DATABASE_URL=
# NEW_DATABASE_URL=

# --- International payments (Stripe + PayPal) ---
# Marka labada key ee Stripe la buuxiyo, Credit/Debit Card wuxuu u wareegaa Stripe Checkout.
# Marka PayPal keys la buuxiyo, doorashada PayPal ayaa muuqata.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox ama live
PAYPAL_MODE=sandbox
